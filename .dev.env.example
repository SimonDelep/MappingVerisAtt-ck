# Copie ce fichier en `dev.env` et renseigne tes valeurs.
# `dev.env` ne doit jamais être commité (secrets).

# ==================== MODE D'EXÉCUTION ====================
# Backend de génération pour Solution_RAG (local) : retrieval | local_llm
RAG_GENERATOR=retrieval

# ==================== RAG local (Solution_RAG) ====================
# RAG_LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# RAG_LOCAL_LLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct
# RAG_TOP_K_TECHNIQUES=20
# RAG_TOP_M_EXAMPLES=5
# RAG_RETRIEVAL_SIM_HIGH=0.50
# RAG_RETRIEVAL_SIM_MED=0.38

# ==================== Together.ai / OpenAI-compatible ====================
# TOGETHER_API_KEY=your-together-api-key
# TOGETHER_BASE_URL=https://api.together.ai/v1
# TOGETHER_CHAT_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
# Pour Solution_RAG_Together : RAG_GENERATOR=together (défaut du dossier).
#
# Alternative OpenAI natif (les scripts tools/ acceptent l'un ou l'autre) :
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_CHAT_MODEL=gpt-4o-mini
#
# Phase 0 (diagnostic, depuis la racine SIEM) :
#   python tools/check_llm_api.py
#   python tools/list_llm_models.py --filter llama
#   python tools/list_llm_models.py --filter qwen
#   python tools/list_llm_models.py --filter deepseek
# Phase 1 (après choix des 3 modèles serverless smoke-testés) :
# RAG_MULTI_LLM_MODELS=meta-llama/Llama-3.3-70B-Instruct-Turbo,Qwen/Qwen2.5-7B-Instruct-Turbo,deepseek-ai/DeepSeek-V4-Flash-0731
